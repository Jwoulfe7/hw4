# Copy to .env (in this folder or in backend/) and fill in. Never commit .env.
# Values in .env override your shell environment.
# Pick a provider (or leave LLM_PROVIDER unset to use the first key present):
LLM_PROVIDER=google
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=your-openai-key-here      # LLM_PROVIDER=openai
# PORTKEY_API_KEY=your-portkey-key-here    # LLM_PROVIDER=portkey
# CHAT_MODEL=gpt-5.6-luna                  # model for openai / portkey
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
